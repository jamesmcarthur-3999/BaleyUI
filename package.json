{
  "name": "baleyui",
  "version": "0.1.0",
  "private": true,
  "description": "Visual platform for building, composing, and evolving AI-powered workflows",
  "author": "James McArthur",
  "license": "MIT",

  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @baleyui/sdk build && pnpm --filter @baleyui/web dev",
    "build": "pnpm --filter @baleyui/sdk build && pnpm --filter @baleyui/web build",
    "start": "pnpm --filter @baleyui/web start",
    "bal:v2:check": "node apps/web/scripts/check-bal-v2-compliance.mjs",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm --filter @baleyui/web test",
    "test:watch": "pnpm --filter @baleyui/web test:watch",
    "test:coverage": "pnpm --filter @baleyui/web test:coverage",
    "db:generate": "pnpm --filter @baleyui/db db:generate",
    "db:migrate": "pnpm --filter @baleyui/db db:migrate",
    "db:deploy": "pnpm --filter @baleyui/db db:deploy",
    "db:push": "pnpm --filter @baleyui/db db:push",
    "db:studio": "pnpm --filter @baleyui/db db:studio"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "happy-dom": "^20.6.1",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "patchedDependencies": {
      "@radix-ui/react-compose-refs@1.1.2": "patches/@radix-ui__react-compose-refs@1.1.2.patch",
      "@radix-ui/react-slot@1.2.4": "patches/@radix-ui__react-slot@1.2.4.patch",
      "@radix-ui/react-slot@1.2.3": "patches/@radix-ui__react-slot@1.2.3.patch"
    }
  }
}
