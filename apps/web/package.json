  "private": true,
  "scripts": {
    "build:baleybots": "if [ -f ../../packages/baleybots/typescript/packages/core/package.json ]; then (cd ../../packages/baleybots/typescript/packages/core && pnpm build); else echo \"Skipping @baleybots/core build (core package not present in this checkout).\"; fi && if [ -f ../../packages/baleybots/typescript/packages/tools/package.json ]; then (cd ../../packages/baleybots/typescript/packages/tools && pnpm build); else echo \"Skipping @baleybots/tools build (tools package not present in this checkout).\"; fi",
    "predev": "pnpm run build:baleybots",
    "dev": "SENTRY_SUPPRESS_TURBOPACK_WARNING=1 next dev --turbopack",
    "prebuild": "pnpm run build:baleybots",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "internal-bb:compile": "node scripts/compile-internal-bb.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
