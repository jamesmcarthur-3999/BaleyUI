# Database
DATABASE_URL=postgresql://username:password@localhost:5432/baleyui

# Better Auth (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Encryption for API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-hex-character-key

# Social SSO (optional — leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show social sign-in buttons (must match server-side provider config)
NEXT_PUBLIC_AUTH_GITHUB=
NEXT_PUBLIC_AUTH_GOOGLE=

# Admin access (comma-separated user IDs and/or emails)
ADMIN_USER_IDS=
ADMIN_USER_EMAILS=

# Vercel Blob Storage (for design asset uploads)
BLOB_READ_WRITE_TOKEN=

# Optional: Vercel
VERCEL_URL=
