# Database
DATABASE_URL=postgresql://username:password@localhost:5432/baleyui

# Better Auth (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Encryption for API keys (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-hex-character-key

# Optional: Vercel
VERCEL_URL=
