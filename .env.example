# BaleyUI Environment Variables
# Copy this file to apps/web/.env.local and fill in your values
# Or run `pnpm setup` to do this automatically.

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/baleyui
# Neon: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/baleyui?sslmode=require
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://username:password@localhost:5432/baleyui

# =============================================================================
# AUTHENTICATION - Better Auth (Required)
# =============================================================================
# Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# ENCRYPTION (Required for storing user API keys)
# =============================================================================
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-hex-character-key

# =============================================================================
# SOCIAL SSO (Optional — leave blank to disable)
# =============================================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to show social sign-in buttons
NEXT_PUBLIC_AUTH_GITHUB=
NEXT_PUBLIC_AUTH_GOOGLE=

# =============================================================================
# ADMIN ACCESS (Optional)
# =============================================================================
# Comma-separated user IDs and/or emails
ADMIN_USER_IDS=
ADMIN_USER_EMAILS=

# =============================================================================
# REDIS - Upstash (Optional)
# =============================================================================
# For caching, rate limiting, and real-time features
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# VERCEL (Optional)
# =============================================================================
VERCEL_URL=
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# LLM PROVIDERS (Optional — users add their own via UI)
# =============================================================================
# These are only used for platform-level features (internal bots)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# WEB SEARCH (Optional)
# =============================================================================
# Enables the web_search built-in tool
# TAVILY_API_KEY=tvly-...

# =============================================================================
# OLLAMA (Optional)
# =============================================================================
# If running Ollama locally for development
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# SENTRY (Optional)
# =============================================================================
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# APP CONFIG
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BaleyUI
NODE_ENV=development
